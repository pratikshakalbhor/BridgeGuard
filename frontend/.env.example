# ─── BridgeGuard AI frontend environment template ───────────────────────────
# Copy to .env.local inside frontend/ for local overrides (never commit).

# Midnight network the wallet is asked to connect to. MUST match the network of
# the deployed BridgeGuard contract/backend. The production deployment runs on
# Midnight Preprod; `preview` is only for local testing against the preview
# deployment. Never put wallet seeds/keys/passwords in frontend env vars.
# VITE_NETWORK_ID=preprod

# Where the BridgeGuard API lives. Empty = same-origin (the backend serves
# both the SPA and /api/*, so production needs no override).
# VITE_API_BASE=

# Vite dev-server proxy target for /api/* (only used by `npm run dev`).
# VITE_API_TARGET=http://localhost:3000