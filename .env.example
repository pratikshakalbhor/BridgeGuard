# ─── BridgeGuard AI — environment template ───────────────────────────────────
# Copy to .env.local in a real deployment:  cp .env.example .env.local
# Backend (src/server.ts, src/network.ts) reads these from the environment.

# HTTP port for the backend API + static SPA host.
# PORT=3000

# Password protecting the contract private state (level-private-state-provider).
# Must be >= 16 characters. CHANGE THIS outside local development.
# PRIVATE_STATE_PASSWORD=Replace-With-A-Strong-Password-1

# Wallet selection — set exactly ONE of these for a deterministic wallet on
# public networks (preview/preprod). Omit both to use the persisted wallet
# from .midnight-state.json (created on first setup).
# MIDNIGHT_WALLET_MNEMONIC="word1 word2 ... word24"
# MIDNIGHT_WALLET_SEED=64hexchars

# Optional network endpoint overrides (defaults point at the local devnet or
# the Midnight public networks, see src/network.ts).
# MIDNIGHT_INDEXER_URL=http://127.0.0.1:8088/api/v4/graphql
# MIDNIGHT_INDEXER_WS_URL=ws://127.0.0.1:8088/api/v4/graphql/ws
# MIDNIGHT_NODE_URL=ws://127.0.0.1:9944
# MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
# MIDNIGHT_FAUCET_URL=https://midnight-tmnight-preview.nethermind.dev
# MIDNIGHT_FAUCET_TIMEOUT_MS=30000